@{
    ViewData["Title"] = "Projects";
}
<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Land Use / Land Cover Mapping</h5>
                <p class="card-text">Mapping of land use patterns across the state to monitor changes and plan development.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Groundwater Prospects Mapping</h5>
                <p class="card-text">Identification of potential groundwater zones to address water scarcity issues.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Crop Acreage and Production Estimation</h5>
                <p class="card-text">Using satellite data to estimate acreage and production of major crops like Wheat and Paddy.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Urban Information System</h5>
                <p class="card-text">Creating detailed GIS layers for major cities to aid in urban planning and management.</p>
            </div>
        </div>
    </div>
     <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Forest Cover Monitoring</h5>
                <p class="card-text">Biennial monitoring of forest cover using high-resolution satellite imagery.</p>
            </div>
        </div>
    </div>
</div>
