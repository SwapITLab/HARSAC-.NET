@{
    ViewData["Title"] = "Home Page";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm text-center" style="background: linear-gradient(to right, #003366, #0055aa); color: white;">
    <div class="container-fluid py-5">
        <h1 class="display-4 fw-bold">Haryana Space Applications Centre (HARSAC)</h1>
        <p class="col-md-8 fs-4 mx-auto">Promoting the use of Space Technology for the holistic development of Haryana.</p>
        <a class="btn btn-warning btn-lg" href="#" role="button">Explore Our Services</a>
    </div>
</div>

<div class="row mb-5">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center">
                <i class="fas fa-satellite fa-3x text-primary mb-3"></i>
                <h3 class="card-title">Remote Sensing</h3>
                <p class="card-text">Utilizing satellite imagery for natural resource management, urban planning, and environmental monitoring.</p>
                <a href="#" class="btn btn-outline-primary">Learn More</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center">
                <i class="fas fa-map-marked-alt fa-3x text-success mb-3"></i>
                <h3 class="card-title">GIS Applications</h3>
                <p class="card-text">Developing Geospatial Information Systems for governance, disaster management, and infrastructure development.</p>
                <a href="#" class="btn btn-outline-success">Learn More</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center">
                <i class="fas fa-user-graduate fa-3x text-warning mb-3"></i>
                <h3 class="card-title">Training & Education</h3>
                <p class="card-text">Building capacity through specialized training programs in Remote Sensing, GIS, and GPS technologies.</p>
                <a href="#" class="btn btn-outline-warning">Learn More</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <h2 class="border-bottom pb-2 mb-3">About HARSAC</h2>
        <p class="lead">HARSAC is a nodal agency of the Department of Science & Technology, Government of Haryana, for Remote Sensing and GIS applications.</p>
        <p>Established in 1986, the centre has been instrumental in providing space-based inputs for various developmental activities in the state. We collaborate with ISRO and other national agencies to bring the benefits of space technology to the grassroots level.</p>
        <ul>
            <li>Natural Resource Mapping</li>
            <li>Disaster Management Support</li>
            <li>Urban & Regional Planning</li>
            <li>e-Governance Solutions</li>
        </ul>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Latest Updates</h4>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <span class="badge bg-danger">New</span> Recruitment for Project Assistants. <br> <small class="text-muted">Feb 20, 2026</small>
                </li>
                <li class="list-group-item">
                    <span class="badge bg-info">Info</span> Training program on QGIS starts next month. <br> <small class="text-muted">Feb 15, 2026</small>
                </li>
                <li class="list-group-item">
                    <span class="badge bg-success">Update</span> Wheat crop acreage estimation report released. <br> <small class="text-muted">Feb 10, 2026</small>
                </li>
            </ul>
        </div>
    </div>
</div>
